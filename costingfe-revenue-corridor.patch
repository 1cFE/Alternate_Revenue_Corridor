+++ b/revenue_offset_sensitivity.py
@@ -0,0 +1,111 @@
+"""Step 5: key-sensitivity study for D-T tokamak alternate revenue streams.
+
+Sweeps the make-or-break parameters for each offset and writes a summary
+figure + prints a findings table.  Uses the revenue_offsets overlay on a
+1 GWe D-T tokamak baseline.
+"""
+
+import numpy as np
+import matplotlib.pyplot as plt
+
+from costingfe import CostModel, ConfinementConcept, Fuel
+from costingfe.revenue_offsets import OffsetParams, apply_offsets
+
+GK = dict(concept=ConfinementConcept.TOKAMAK, fuel=Fuel.DT, availability=0.85)
+
+m = CostModel(ConfinementConcept.TOKAMAK, Fuel.DT)
+R = m.forward(net_electric_mw=1000.0, availability=0.85, lifetime_yr=30.0,
+              size_from_power=True)
+BASE = float(R.costs.lcoe)
+
+
+def net(**kw):
+    return apply_offsets(R, OffsetParams(**kw), **GK).net_lcoe
+
+
+# ---------------------------------------------------------------- sensitivities
+au_price = np.linspace(40_000, 160_000, 25)
+au_net = [net(gold_on=True, gold_price_usd_per_kg=p) for p in au_price]
+
+au_rate = np.linspace(400, 1600, 25)  # kg/GWth/yr span (Marathon basis)
+au_rate_net = [net(gold_on=True, gold_kg_per_gwth_yr=k) for k in au_rate]
+
+mh_me = np.linspace(0.1, 3.0, 30)
+heat_net = [net(heat_on=True, heat_frac=0.8, heat_price_ratio=r) for r in mh_me]
+heat_net_50 = [net(heat_on=True, heat_frac=0.5, heat_price_ratio=r) for r in mh_me]
+ETA_GEN = OffsetParams().eta_gen
+
+# H2 diverts a PARTIAL slice (0.5) so net LCOE on the remaining electricity is
+# defined; a 100%-H2 plant is an LCOH question, not an LCOE one.
+h2_price = np.linspace(1.0, 9.0, 30)
+h2_net = [net(h2_on=True, h2_frac=0.5, h2_price_usd_per_kg=p) for p in h2_price]
+h2_net_hte = [net(h2_on=True, h2_frac=0.5, h2_price_usd_per_kg=p, h2_conv_eff=0.85)
+              for p in h2_price]
+
+# gold credit is a nearly flat $/MWh reduction -> report it
+gold_credit = BASE - net(gold_on=True)
+
+# ---------------------------------------------------------------- figure
+plt.rcParams.update({"font.size": 10, "axes.grid": True, "grid.alpha": 0.3})
+fig, ax = plt.subplots(2, 2, figsize=(11, 8))
+fig.suptitle("Alternate-revenue sensitivities for a 1 GWe D-T tokamak "
+             f"(base LCOE = ${BASE:.0f}/MWh)", fontsize=13, fontweight="bold")
+
+# (a) gold price
+a = ax[0, 0]
+a.plot(au_price / 1e3, au_net, color="#c9a227", lw=2.5)
+a.axhline(BASE, ls="--", c="gray", label="base (elec only)")
+a.axhline(0, ls=":", c="k", lw=0.8)
+a.axvline(100, ls=":", c="#c9a227", label="~current $100k/kg")
+a.set_xlabel("gold price [$k/kg]"); a.set_ylabel("net LCOE [$/MWh]")
+a.set_title("(a) Gold — the dominant, additive lever"); a.legend(fontsize=8)
+
+# (b) gold production rate
+b = ax[0, 1]
+b.plot(au_rate / 1e3, au_rate_net, color="#c9a227", lw=2.5)
+b.axhline(BASE, ls="--", c="gray")
+b.axvline(2.0, ls=":", c="#c9a227", label="~2 t/GWfus central")
+b.set_xlabel("gold production [t / GW$_{fus}$ / yr]"); b.set_ylabel("net LCOE [$/MWh]")
+b.set_title("(b) Gold rate (TBR-driven: 0.73–3.1 t)"); b.legend(fontsize=8)
+
+# (c) heat crossover
+c = ax[1, 0]
+c.plot(mh_me, heat_net, lw=2.5, color="#c1440e", label="80% heat")
+c.plot(mh_me, heat_net_50, lw=2.0, color="#e07a5f", ls="--", label="50% cogen")
+c.axhline(BASE, ls="--", c="gray")
+c.axvline(ETA_GEN, ls=":", c="#c1440e", label=f"crossover Mh/Me=η_gen={ETA_GEN}")
+c.set_ylim(-250, 250)
+c.set_xlabel("heat/elec price ratio  Mh/Me"); c.set_ylabel("net LCOE [$/MWh]")
+c.set_title("(c) Heat — wins only above Mh/Me = η_gen"); c.legend(fontsize=8)
+
+# (d) H2 crossover
+d = ax[1, 1]
+d.plot(h2_price, h2_net, lw=2.5, color="#1b998b", label="LTE η=0.70")
+d.plot(h2_price, h2_net_hte, lw=2.0, color="#3a7ca5", ls="--", label="HTE η=0.85")
+d.axhline(BASE, ls="--", c="gray", label="base (elec only)")
+d.set_xlabel("hydrogen price [$/kg]"); d.set_ylabel("net LCOE [$/MWh]")
+d.set_title("(d) H₂ — beats elec only at high price"); d.legend(fontsize=8)
+
+fig.tight_layout(rect=[0, 0, 1, 0.96])
+OUT = r"C:\Users\mallo\Deterministic_Concept_scoring\revenue_offset_sensitivity.png"
+fig.savefig(OUT, dpi=140)
+print("saved:", OUT)
+
+# ---------------------------------------------------------------- findings
+def bre_h2(conv):
+    series = h2_net if conv == 0.70 else h2_net_hte
+    for p, n_lte in zip(h2_price, series):
+        if n_lte == n_lte and n_lte < BASE:  # skip NaN
+            return f"{p:.1f}"
+    return ">9.0"
+
+print(f"\nBASE LCOE (elec only)            {BASE:8.1f} $/MWh")
+print(f"Gold credit @ $100k/kg           {gold_credit:8.1f} $/MWh  (flat, additive)")
+print(f"  -> net LCOE with gold          {net(gold_on=True):8.1f} $/MWh")
+print(f"Gold @ $60k/kg  net LCOE         {net(gold_on=True, gold_price_usd_per_kg=60000):8.1f} $/MWh")
+print(f"Gold @ 0.5 t/GWth (low) net      {net(gold_on=True, gold_kg_per_gwth_yr=500):8.1f} $/MWh")
+print(f"Heat crossover Mh/Me             {ETA_GEN:8.2f}  (below this, electricity wins)")
+print(f"H2 breakeven price (LTE 0.70)    {bre_h2(0.70):>8s} $/kg  (50% divert)")
+print(f"H2 breakeven price (HTE 0.85)    {bre_h2(0.85):>8s} $/kg  (50% divert)")
+print(f"Full stack (gold+heat1.5+h2$5)   "
+      f"{net(gold_on=True, heat_on=True, heat_frac=0.3, heat_price_ratio=1.5, h2_on=True, h2_frac=0.2, h2_price_usd_per_kg=5.0):8.1f} $/MWh")
