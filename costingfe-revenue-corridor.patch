diff --git a/cogen_capacity_optimizer.py b/cogen_capacity_optimizer.py
new file mode 100644
index 0000000..e87c5d7
--- /dev/null
+++ b/cogen_capacity_optimizer.py
@@ -0,0 +1,62 @@
+"""Fixed firm heat (200 MW_th at fixed $/MWh_th). Mh/Me slider drives the
+ELECTRICITY price (Me = Mh / ratio). Optimize total reactor size (=> % cogen)
+for max NPV. Reactor is baseload; a 4 h TES lets the plant throttle power UP
+during the 4 evening-peak hours (heat covered from TES). Capacity market pays
+$/kW-yr on the peak-deliverable turbine. Reactor scaling from 1costingFE."""
+import numpy as np
+
+PTH=np.array([796,1128,1699,2452,3140,4207,5332.]); RCAP=np.array([4215,5000,6140,7384,8356,9656,11132.])
+reactor_cap=lambda Q: float(np.interp(Q,PTH,RCAP))
+MULT=np.array([0.80,0.75,0.72,0.72,0.75,0.82,0.92,1.00,0.98,0.85,0.70,0.60,
+               0.55,0.55,0.60,0.72,0.95,1.35,1.75,1.85,1.60,1.25,1.00,0.88]); MULT=MULT/MULT.mean()
+ETA=0.40; AVAIL=0.85; CRF=0.0806; ANN=12.409
+TURBk=258; TESk=30; BOPk=200; MH=30.0; HFIRM=200.0; TES_H=4.0
+HRS=365*AVAIL; tesMwh=HFIRM*TES_H
+
+def evaluate(Q, ratio, capkw, smart=True):
+    ME=MH/ratio; PRICE=MULT*ME
+    order=np.argsort(PRICE)[::-1]; top=PRICE[order[:4]]; off=PRICE[order[4:]]
+    heatRev=HFIRM*MH*8760*AVAIL/1e6
+    if smart:                       # throttle up in top-4 hrs (Q*eta), heat from TES
+        peakMWe=Q*ETA
+        powRev=ETA*(Q*top.sum() + (Q-240)*off.sum())*365*AVAIL/1e6
+        turbMWe=Q*ETA; tes=tesMwh
+    else:                           # rigid: flat baseload power, no TES, no boost
+        peakMWe=(Q-HFIRM)*ETA
+        powRev=(Q-HFIRM)*ETA*ME*8760*AVAIL/1e6
+        turbMWe=(Q-HFIRM)*ETA; tes=0.0
+    capRev=peakMWe*1e3*capkw/1e6
+    cap=reactor_cap(Q)+TURBk*turbMWe*1e3/1e6+TESk*tes*1e3/1e6+BOPk*HFIRM*1e3/1e6
+    om=127.0*Q/3140.0
+    profit=powRev+heatRev+capRev-(CRF*cap+om)
+    return dict(npv=profit*ANN/1e3, profit=profit, cogen=HFIRM/Q*100, turbMWe=turbMWe,
+                powRev=powRev, heatRev=heatRev, capRev=capRev, cap=cap, ME=ME, peakMWe=peakMWe)
+
+def optimize(ratio, capkw, smart=True):
+    Qs=np.linspace(800,6000,260)
+    best=None
+    for Q in Qs:
+        r=evaluate(Q,ratio,capkw,smart)
+        if best is None or r['npv']>best[1]['npv']: best=(Q,r)
+    return best
+
+CAP=87.5   # $/kW-yr midpoint of 75-100
+print(f"Firm heat 200 MW_th @ ${MH}/MWh_th ; TES 4 h ; capacity ${CAP}/kW-yr\n")
+print(f"{'Mh/Me':>6}{'Me $/MWh':>10}{'opt %cogen':>11}{'reactor MW_th':>14}{'turbine MWe':>12}{'NPV $B':>9}{'TES+disp add $B':>16}")
+for ratio in [0.25,0.4,0.5,0.7,1.0]:
+    Q,r=optimize(ratio,CAP,smart=True)
+    _,rb=optimize(ratio,CAP,smart=False)                    # best rigid plant
+    # NPV added by TES+smart at the SAME optimal reactor:
+    r_rigid_sameQ=evaluate(Q,ratio,CAP,smart=False)
+    add=(r['npv']-r_rigid_sameQ['npv'])
+    print(f"{ratio:>6}{r['ME']:>10.0f}{r['cogen']:>10.1f}%{Q:>14.0f}{r['turbMWe']:>12.0f}{r['npv']:>9.2f}{add:>16.2f}")
+
+print("\nDecompose the TES+smart-dispatch value (at Mh/Me=0.5, opt reactor):")
+Q,r=optimize(0.5,CAP,True); rr=evaluate(Q,0.5,CAP,False)
+print(f"  peak energy premium : +${(r['powRev']-rr['powRev']):.0f}M/yr")
+print(f"  extra firm capacity : +${(r['capRev']-rr['capRev']):.0f}M/yr  (turbine {r['turbMWe']:.0f} vs {rr['turbMWe']:.0f} MWe)")
+print(f"  minus TES capital   : -${CRF*(TESk*tesMwh*1e3/1e6):.1f}M/yr")
+print(f"  => net +${(r['profit']-rr['profit']):.0f}M/yr  = +${(r['npv']-rr['npv']):.2f}B NPV")
+print("\nCapacity-price sensitivity (Mh/Me=0.5):")
+for ck in [0,75,100]:
+    Q,r=optimize(0.5,ck,True); print(f"  ${ck}/kW-yr: opt %cogen {r['cogen']:.1f}%, reactor {Q:.0f} MW_th, NPV ${r['npv']:.2f}B")
diff --git a/cogen_size_optimizer.py b/cogen_size_optimizer.py
new file mode 100644
index 0000000..12d2556
--- /dev/null
+++ b/cogen_size_optimizer.py
@@ -0,0 +1,57 @@
+"""Firm 200 MW_th heat anchor; upsize reactor+turbine for power if NPV-accretive.
+TES fixed 4 h (on the heat slice). Optimize reactor size (=> % cogen) for max NPV.
+Reactor capital scaling taken from 1costingFE (D-T tokamak)."""
+import numpy as np
+
+# reactor capital (excl turbine) vs thermal power, from 1costingFE
+PTH = np.array([796,1128,1699,2452,3140,4207,5332.])
+RCAP= np.array([4215,5000,6140,7384,8356,9656,11132.])   # M$
+def reactor_cap(Q): return np.interp(Q, PTH, RCAP)        # M$ (linear interp/extrap)
+
+MULT=np.array([0.80,0.75,0.72,0.72,0.75,0.82,0.92,1.00,0.98,0.85,0.70,0.60,
+               0.55,0.55,0.60,0.72,0.95,1.35,1.75,1.85,1.60,1.25,1.00,0.88])
+MULT=MULT/MULT.mean()
+ETA=0.40; AVAIL=0.85; CRF=0.0806; ANN=12.409
+TURBk=258; TESk=30; BOPk=200; HFIRM=200.0                 # MW_th firm heat
+TES_H=4.0; tesMwh=HFIRM*TES_H                             # 800 MWh_th
+HRS=365*AVAIL
+
+def npv(Q, ratio, ME):
+    PRICE=MULT*ME; MH=ratio*ME
+    top4=np.sort(PRICE)[::-1][:4]
+    powBase=(Q-HFIRM)*ETA                                 # MW_e baseload power
+    # revenue: baseload power at mean; +heat-slice diverted to power in top-4 hrs
+    powRevBase = powBase*PRICE.mean()*8760*AVAIL/1e6
+    flexPow = HFIRM*ETA                                   # 80 MW_e freed in peak hrs
+    powRevFlex = flexPow*top4.sum()*365*AVAIL/1e6 - flexPow*top4.size*PRICE.mean()*0  # peak-only
+    heatRev = HFIRM*MH*8760*AVAIL/1e6
+    turbMWe = Q*ETA                                       # sized to full-throttle peak
+    cap = reactor_cap(Q) + TURBk*turbMWe*1e3/1e6 + TESk*tesMwh*1e3/1e6 + BOPk*HFIRM*1e3/1e6
+    om  = 127.0*Q/3140.0 + 0.8                            # scale O&M with size
+    profit = powRevBase+powRevFlex+heatRev - (CRF*cap+om)
+    cogen = HFIRM/Q*100                                   # heat share of thermal
+    return profit*ANN/1e3, profit, cogen, turbMWe, cap    # NPV $B
+
+def optimize(ratio, ME):
+    Qs=np.linspace(800,6000,200)
+    res=[npv(Q,ratio,ME) for Q in Qs]
+    npvs=np.array([r[0] for r in res])
+    i=int(np.argmax(npvs))
+    return Qs[i], res[i]
+
+print("Marginal power LCOE (why upsizing pays despite $110 average LCOE):")
+for Q in [1500,3000,4500]:
+    dcap=(reactor_cap(Q+100)-reactor_cap(Q))+TURBk*100*ETA*1e3/1e6
+    dMWh=100*ETA*8760*AVAIL
+    print(f"  at Q={Q:.0f} MW_th: marginal +100 MW_th -> ${(CRF*dcap)*1e6/dMWh:.0f}/MWh_e")
+
+print("\nOptimal reactor size / % cogen  (firm 200 MW_th heat, 4 h TES):")
+print(f"{'Mh/Me':>7}{'Me $/MWh':>10}{'opt Q MW_th':>13}{'% cogen':>9}{'turbine MWe':>13}{'NPV $B':>9}")
+for ME in [60]:
+    for ratio in [0.2,0.5,0.8,1.0]:
+        Q,r=optimize(ratio,ME)
+        print(f"{ratio:>7}{ME:>10}{Q:>13.0f}{r[2]:>8.1f}%{r[3]:>13.0f}{r[0]:>9.2f}")
+print("  --- vs electricity price level (ratio fixed 0.5) ---")
+for ME in [40,60,80,120]:
+    Q,r=optimize(0.5,ME)
+    print(f"{0.5:>7}{ME:>10}{Q:>13.0f}{r[2]:>8.1f}%{r[3]:>13.0f}{r[0]:>9.2f}")
diff --git a/heat_arbitrage_optimizer.py b/heat_arbitrage_optimizer.py
new file mode 100644
index 0000000..23e831a
--- /dev/null
+++ b/heat_arbitrage_optimizer.py
@@ -0,0 +1,115 @@
+"""Optimize turbine size (% cogen) for max NPV of a fusion cogen plant that
+firms a heat contract and arbitrages a volatile power market with TES.
+
+Plant: constant fusion thermal Q; a turbine of thermal capacity C converts to
+electricity (eta_gen); the rest is sold as firm heat at Mh, with TES buffering
+so the heat contract stays flat while electricity is timed into price peaks.
+
+Dispatch (merit order): each hour route thermal to electricity when it out-earns
+heat (eta_gen*p(t) > Mh), up to turbine capacity C; otherwise to heat. TES is
+sized to hold the heat contract flat across the electricity (peak) hours.
+"""
+import numpy as np
+import matplotlib.pyplot as plt
+
+# ---- representative US duck-curve day (normalized), CAISO/ERCOT-shaped -------
+MULT = np.array([0.80,0.75,0.72,0.72,0.75,0.82,0.92,1.00,0.98,0.85,0.70,0.60,
+                 0.55,0.55,0.60,0.72,0.95,1.35,1.75,1.85,1.60,1.25,1.00,0.88])
+MULT = MULT / MULT.mean()                      # mean = 1.0
+ME = 60.0                                       # $/MWh mean electricity price
+PRICE = MULT * ME                               # hourly $/MWh
+MH_RATIO = 0.5
+MH = MH_RATIO * ME                              # $/MWh_th firm heat price
+
+# ---- plant + economics ------------------------------------------------------
+Q = 2500.0            # MW_th constant fusion thermal (~1 GWe-equiv at eta_gen)
+ETA = 0.40
+AVAIL = 0.85
+# Steam turbine is NOT a fast starter: keep it warm at a minimum load so it can
+# ramp to full for the PREDICTABLE daily evening peak (no cold two-shifting, and
+# no chasing sub-hour scarcity spikes). This forces some off-peak electricity.
+MIN_LOAD_FRAC = 0.25
+CRF = 0.0806          # 7%/30 yr
+ANNUITY = 12.409      # sum discount, 7%/30yr  (NPV = profit * ANNUITY)
+BASE_CAP = 8614.0 - 258.0   # M$ plant capital minus the full turbine (CAS23)
+OM = 127.0; FUEL = 0.8       # M$/yr (CAS70, CAS80)
+TURB_PER_KWE = 258.0         # $/kW_e (CAS23 basis)
+TES_PER_KWHTH = 30.0         # $/kWh_th
+BOP_PER_KWTH = 200.0         # $/kW_th heat export
+
+def dispatch(C):
+    """Given turbine thermal capacity C, return per-hour electricity thermal,
+    firm heat H, TES size (MWh_th), and annual revenues."""
+    # warm turbine: full C when electricity out-earns heat, else min-load idle
+    peak = ETA * PRICE > MH
+    elec_hour = np.where(peak, np.minimum(C, Q), MIN_LOAD_FRAC * C)  # MW_th to turbine
+    heat_prod = Q - elec_hour                                       # MW_th to heat
+    H = heat_prod.mean()                                            # firm contract
+    # TES sizing: cumulative deviation of heat production from firm H (wrap 24h)
+    dev = heat_prod - H
+    cum = np.cumsum(np.concatenate([dev, dev]))    # two days to catch wrap
+    tes = cum.max() - cum.min()                    # MWh_th storage span
+    # annual revenue (M$)
+    hrs = 365.0 * AVAIL
+    elec_rev = (elec_hour * ETA * PRICE).sum() * hrs / 1e6
+    heat_rev = H * MH * 8760.0 * AVAIL / 1e6
+    # flat-price counterfactual (same electricity energy, sold at mean price)
+    elec_energy_mwh = (elec_hour * ETA).sum() * hrs
+    flat_rev = elec_energy_mwh * ME / 1e6
+    return elec_hour, H, tes, elec_rev, heat_rev, flat_rev
+
+def profit(C):
+    _, H, tes, elec_rev, heat_rev, flat_rev = dispatch(C)
+    cap = (BASE_CAP + TURB_PER_KWE * C * ETA * 1e3 / 1e6
+           + TES_PER_KWHTH * tes * 1e3 / 1e6 + BOP_PER_KWTH * H * 1e3 / 1e6)
+    ann_cost = CRF * cap + OM + FUEL
+    return elec_rev + heat_rev - ann_cost, H, tes, elec_rev, heat_rev, flat_rev, cap
+
+# ---- sweep turbine size -----------------------------------------------------
+Cs = np.linspace(50, Q, 120)
+res = [profit(C) for C in Cs]
+prof = np.array([r[0] for r in res])
+Hs   = np.array([r[1] for r in res])
+cogen_pct = Hs / Q * 100.0
+istar = int(np.argmax(prof))
+Cstar = Cs[istar]
+p, Hst, tesst, erev, hrev, frev, capst = profit(Cstar)
+
+print(f"Duck-curve day: mean ${ME}/MWh, peak ${PRICE.max():.0f}, trough ${PRICE.min():.0f} "
+      f"(peak/trough {PRICE.max()/PRICE.min():.1f}x); Mh=${MH:.0f}/MWh_th (Mh/Me={MH_RATIO})")
+print(f"Electricity beats heat when price > Mh/eta = ${MH/ETA:.0f}/MWh "
+      f"-> {(ETA*PRICE>MH).sum()} hrs/day\n")
+print(f"OPTIMUM: turbine C* = {Cstar:.0f} MW_th ({Cstar*ETA:.0f} MW_e), "
+      f"cogen = {Hst/Q*100:.0f}% heat / {100-Hst/Q*100:.0f}% elec-capable")
+print(f"  firm heat H = {Hst:.0f} MW_th ; TES = {tesst:.0f} MWh_th "
+      f"({tesst/Hst:.1f} h of heat)")
+print(f"  annual: elec ${erev:.0f}M (flat-price ${frev:.0f}M -> peaking premium +${erev-frev:.0f}M), "
+      f"heat ${hrev:.0f}M")
+print(f"  annual PROFIT ${p:.0f}M/yr ; NPV = ${p*ANNUITY/1e3:.2f}B ; capital ${capst:.0f}M")
+# compare to all-heat and all-electricity corners
+p_heat,_,_,_,_,_,_ = profit(50.0)
+p_full,_,_,_,_,_,_ = profit(Q)
+print(f"  vs all-heat corner ${p_heat:.0f}M/yr ; vs full-turbine ${p_full:.0f}M/yr")
+
+# ---- figure -----------------------------------------------------------------
+fig, (a1, a2) = plt.subplots(1, 2, figsize=(12.5, 5))
+a1.plot(range(24), PRICE, color="#1b6ca8", lw=2.2, marker="o", ms=3)
+a1.axhline(MH/ETA, ls="--", c="#c1440e", lw=1.3, label=f"elec beats heat  >${MH/ETA:.0f}/MWh")
+a1.fill_between(range(24), MH/ETA, PRICE, where=PRICE>MH/ETA, color="#c1440e", alpha=0.15)
+a1.set_xlabel("hour of day"); a1.set_ylabel("price [$/MWh]")
+a1.set_title(f"Representative US duck-curve day (mean ${ME})", fontweight="bold", fontsize=11)
+a1.legend(fontsize=8.5); a1.grid(alpha=0.3)
+
+a2.plot(cogen_pct, prof, lw=2.6, color="#2f9e63")
+a2.plot(Hst/Q*100, p, "o", ms=9, color="#c1440e",
+        label=f"optimum {Hst/Q*100:.0f}% cogen\nprofit ${p:.0f}M/yr")
+a2.set_xlabel("% cogen (firm heat share of thermal)")
+a2.set_ylabel("annual profit [$M/yr]")
+a2.set_title("Turbine size (% cogen) vs profit — load-following cogen (warm turbine)\n"
+             f"Mh/Me={MH_RATIO}, TES sized to firm heat", fontweight="bold", fontsize=11)
+a2.invert_xaxis()  # more heat (smaller turbine) to the right
+a2.legend(fontsize=9, loc="lower center"); a2.grid(alpha=0.3)
+fig.tight_layout()
+OUT = r"C:\Users\mallo\Deterministic_Concept_scoring\heat_arbitrage_optimization.png"
+fig.savefig(OUT, dpi=140)
+print("\nsaved:", OUT)
diff --git a/heat_peaking_v2.py b/heat_peaking_v2.py
new file mode 100644
index 0000000..2197cf9
--- /dev/null
+++ b/heat_peaking_v2.py
@@ -0,0 +1,100 @@
+"""Fixed-price heat (constant Mh) + volatile Me(t). Two questions:
+  P1: does upsizing the steam turbine to catch the daily peak beat all-heat?
+      (hinges on turbine off-peak floor: two-shift vs must-run min-load)
+  P2: if the plant MUST deliver some net power, what is the optimal % cogen,
+      given TES and the 24h price volatility?
+"""
+import numpy as np
+import matplotlib.pyplot as plt
+
+MULT = np.array([0.80,0.75,0.72,0.72,0.75,0.82,0.92,1.00,0.98,0.85,0.70,0.60,
+                 0.55,0.55,0.60,0.72,0.95,1.35,1.75,1.85,1.60,1.25,1.00,0.88])
+MULT = MULT / MULT.mean()
+ME = 60.0
+PRICE = MULT * ME                 # Me(t), $/MWh
+MH = 0.5 * ME                     # constant contract heat price $30/MWh_th
+Q = 2500.0; ETA = 0.40; AVAIL = 0.85; CRF = 0.0806
+BASE_CAP = 8614.0 - 258.0; OM = 127.0; FUEL = 0.8
+TURB_PER_KWE = 258.0; TES_PER_KWHTH = 30.0; BOP_PER_KWTH = 200.0
+
+def dispatch(C, min_load=0.0, mandate_mwe=0.0, start_cost_k=0.0):
+    """Daily dispatch. Returns (profit M$/yr, cogen%, TES MWh_th, peaking premium)."""
+    peak = ETA * PRICE > MH
+    e = np.where(peak, min(C, Q), min_load * C)          # MW_th to turbine
+    # mandate: if daily elec energy short, raise highest-price off-peak hours to C
+    target = mandate_mwe * 24 / ETA                       # MW_th-hours/day needed
+    order = np.argsort(-PRICE)
+    i = 0
+    while e.sum() < target and i < 24:
+        h = order[i]
+        if e[h] < min(C, Q):
+            e[h] = min(C, Q)
+        i += 1
+    e = np.minimum(e, Q)
+    heat = Q - e
+    H = heat.mean()
+    dev = heat - H
+    cum = np.cumsum(np.concatenate([dev, dev]))
+    tes = cum.max() - cum.min()
+    hrs = 365.0 * AVAIL
+    elec_rev = (e * ETA * PRICE).sum() * hrs / 1e6
+    heat_rev = H * MH * 8760.0 * AVAIL / 1e6
+    flat_rev = (e * ETA).sum() * hrs * ME / 1e6
+    starts = 365.0 * (1.0 if (min_load == 0.0 and (e > 0).any()) else 0.0)
+    start_cost = starts * start_cost_k * (C * ETA) / 1e6  # $/MW_e/start -> M$
+    cap = (BASE_CAP + TURB_PER_KWE*C*ETA*1e3/1e6
+           + TES_PER_KWHTH*tes*1e3/1e6 + BOP_PER_KWTH*H*1e3/1e6)
+    profit = elec_rev + heat_rev - (CRF*cap + OM + FUEL) - start_cost
+    delivered_mwe = (e * ETA).sum() / 24.0
+    if delivered_mwe < mandate_mwe - 1e-6:          # infeasible: penalize
+        profit -= 1e5
+    return profit, H/Q*100, tes, elec_rev - flat_rev, elec_rev
+
+# ---- PART 1: does a turbine pay? sensitivity to off-peak floor --------------
+print("PART 1 — upsizing the turbine to catch the peak (constant Mh=$30, Me duck curve)")
+Cs = np.linspace(50, Q, 100)
+p1 = {}
+for ml, sc, lab in [(0.0, 30.0, "two-shift (off + $30/MW warm-start/day)"),
+                    (0.10, 0.0, "min-load 10%"),
+                    (0.25, 0.0, "min-load 25%")]:
+    prof = np.array([dispatch(C, min_load=ml, start_cost_k=sc)[0] for C in Cs])
+    p1[lab] = prof
+    i = int(np.argmax(prof))
+    print(f"  {lab:38s}: best at {dispatch(Cs[i],min_load=ml,start_cost_k=sc)[1]:.0f}% cogen, "
+          f"profit ${prof[i]:.0f}M/yr  (all-heat ${prof[0]:.0f}M/yr)")
+
+# ---- PART 2: forced to deliver net power -> optimal % cogen ------------------
+print("\nPART 2 — plant MUST deliver a minimum net electricity (min-load 25% steam)")
+print(f"{'mandate MWe':>12}{'opt %cogen':>12}{'opt turbine MWe':>16}{'TES MWh_th':>12}{'profit $M/yr':>14}")
+for mandate in [100, 200, 300, 500]:
+    prof = np.array([dispatch(C, min_load=0.25, mandate_mwe=mandate)[0] for C in Cs])
+    i = int(np.argmax(prof))
+    _, cog, tes, _, _ = dispatch(Cs[i], min_load=0.25, mandate_mwe=mandate)
+    print(f"{mandate:>12}{cog:>11.0f}%{Cs[i]*ETA:>15.0f}{tes:>12.0f}{prof[i]:>14.0f}")
+
+# ---- figure -----------------------------------------------------------------
+fig, (a1, a2) = plt.subplots(1, 2, figsize=(13, 5))
+for lab, prof in p1.items():
+    a1.plot([dispatch(C)[1] for C in Cs], prof, lw=2.4, label=lab)
+a1.set_xlabel("% cogen (firm heat share)"); a1.set_ylabel("annual profit [$M/yr]")
+a1.invert_xaxis()
+a1.set_title("P1: does upsizing the turbine pay?\nconstant Mh=$30, Me duck curve",
+             fontweight="bold", fontsize=11)
+a1.legend(fontsize=8); a1.grid(alpha=0.3)
+
+mand = np.linspace(0, 600, 40)
+opt_cog, opt_prof = [], []
+for mm in mand:
+    prof = np.array([dispatch(C, min_load=0.25, mandate_mwe=mm)[0] for C in Cs])
+    i = int(np.argmax(prof))
+    opt_cog.append(dispatch(Cs[i], min_load=0.25, mandate_mwe=mm)[1])
+    opt_prof.append(prof[i])
+a2.plot(mand, opt_cog, lw=2.6, color="#2f9e63")
+a2.set_xlabel("mandated net electricity [MW_e avg]")
+a2.set_ylabel("optimal % cogen", color="#2f9e63")
+a2.set_title("P2: optimal % cogen vs a net-power mandate\n(steam min-load 25%, TES sized to firm heat)",
+             fontweight="bold", fontsize=11)
+a2.grid(alpha=0.3)
+fig.tight_layout()
+OUT = r"C:\Users\mallo\Deterministic_Concept_scoring\heat_peaking_v2.png"
+fig.savefig(OUT, dpi=140); print("\nsaved:", OUT)
