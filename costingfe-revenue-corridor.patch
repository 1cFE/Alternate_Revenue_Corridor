@@ -0,0 +1,156 @@
+"""Itemized cost/revenue comparison of each alternate revenue stream, benchmarked
+against a 1 GWe D-T tokamak baseline. Prints per-stream ledgers + a figure.
+
+Heat is shown two ways:
+  * Heat BEST      -- recreates the interactive tool's ~1 c/kWh heat-led point:
+                      a smaller reactor (full-electric net 500 MWe) diverting 80%
+                      of output -> ~1 GWth firm heat + ~100 MWe electricity
+                      byproduct, high-grade heat @ $78/MWh_th + $150/kW-yr cap.
+  * Heat (Realistic) -- SAME P_fus as the 1 GWe baseline, a realistic 200 MWth
+                      high-grade heat contract @ $40/MWh_th, no TES / capacity.
+"""
+
+import numpy as np
+import matplotlib.pyplot as plt
+
+from costingfe import CostModel, ConfinementConcept, Fuel
+from costingfe.revenue_offsets import OffsetParams, apply_offsets
+
+GK = dict(concept=ConfinementConcept.TOKAMAK, fuel=Fuel.DT, availability=0.85)
+m = CostModel(ConfinementConcept.TOKAMAK, Fuel.DT)
+
+# Baseline 1 GWe plant -- reference LCOE line + P_fus anchor for the realistic case
+Rb = m.forward(net_electric_mw=1000.0, availability=0.85, lifetime_yr=30.0,
+               size_from_power=True)
+BASE = float(Rb.costs.lcoe)
+PN_BASE = float(Rb.power_table.p_net)  # MWe
+
+# Heat-led "best" plant: full-electric net 500 MWe, then divert 80% of output ->
+# 1 GWth heat + 100 MWe electricity byproduct (matches the tool's best case).
+Rbest = m.forward(net_electric_mw=500.0, availability=0.85, lifetime_yr=30.0,
+                  size_from_power=True)
+
+HF_200 = 200.0 * 0.40 / PN_BASE          # heat_frac that diverts exactly 200 MWth
+NET_REAL = PN_BASE * (1.0 - HF_200)      # resulting net electric of the realistic case
+
+# (name, ForwardResult, OffsetParams)
+CASES = [
+    ("Baseline (Electricity only)", Rb, OffsetParams()),
+    ("Electricity + Gold", Rb,
+        OffsetParams(gold_on=True)),  # cooldown 10 yr @ 3% (defaults)
+    ("Electricity + Heat (Power-led)", Rb, OffsetParams(
+        heat_on=True, heat_frac=HF_200, heat_price_usd_per_mwhth=50.0,
+        heat_storage_hours=0.0, capacity_price_usd_per_kw_yr=0.0)),
+    # capacity tuned to $139/kW-yr so the heat-led point lands exactly on 1 c/kWh
+    ("Electricity + Heat (Heat-led)", Rbest, OffsetParams(
+        heat_on=True, heat_frac=0.8, heat_price_usd_per_mwhth=78.0,
+        heat_storage_hours=4.0, capacity_price_usd_per_kw_yr=139.0,
+        upsized_turbine=True)),
+    ("Electricity + H2 (Power-led)", Rb, OffsetParams(
+        h2_on=True, h2_frac=0.10, h2_cf_recovery_frac=0.0118,
+        h2_electrolyzer_mw=200.0, h2_price_usd_per_kg=4.0)),
+    ("Electricity + H2 (H2-led)", Rb, OffsetParams(
+        h2_on=True, h2_frac=0.90, h2_cf_recovery_frac=0.053,
+        h2_electrolyzer_mw=900.0, h2_price_usd_per_kg=4.0)),
+]
+
+
+def ledger(name, R, off):
+    c = R.costs
+    o = apply_offsets(R, off, **GK)
+    base_cost = float(c.cas90 + c.cas70 + c.cas80)
+    print(f"\n{'='*66}\n{name}\n{'='*66}")
+    print(f"  base plant cost        {base_cost:8.1f} M$/yr")
+    for it in o.items:
+        if it["kind"] == "memo":
+            continue
+        sign = "+" if it["kind"] == "revenue" else "-"
+        print(f"  {it['kind']:8s} {it['label']:40s} {sign}{abs(it['musd_yr']):7.1f}")
+    print(f"  electricity sold       {o.energy_sold_mwh/1e6:8.3f} TWh")
+    for n in o.notes:
+        print(f"  - {n}")
+    print(f"  EFFECTIVE LCOE {o.net_lcoe:8.1f} $/MWh   (D {o.net_lcoe-BASE:+.1f})")
+    return o.net_lcoe
+
+
+results = [(name, ledger(name, R, off)) for name, R, off in CASES]
+labels = [r[0] for r in results]
+vals = [r[1] for r in results]
+LCOE_REAL = vals[3]
+
+# ------------------------------------------------------------------ figure
+colors = ["#6c757d", "#c9a227", "#2f9e63", "#c1440e", "#1b998b", "#5f4b8b"]
+fig, ax = plt.subplots(figsize=(10, 5.4))
+CAP = 160.0  # x cap; the H2-led bar ($612) is off-scale -> clipped + flagged
+bars = ax.barh(range(len(labels)), [min(v, CAP) for v in vals], color=colors)
+for _b, _v in zip(bars, vals):
+    if _v > CAP:
+        _b.set_hatch("////")
+        _b.set_edgecolor("white")
+ax.axvline(BASE, ls="--", c="gray", lw=1, label=f"base {BASE:.0f} $/MWh")
+ax.axvline(0, ls=":", c="k", lw=0.8)
+ax.set_yticks(range(len(labels)))
+ax.set_yticklabels(labels)
+ax.invert_yaxis()
+
+# smaller-font exact-conditions note under the two heat bars
+_tr = ax.get_yaxis_transform()
+_detail = {
+    1: ("1 t/GW_th/yr, 100 t Hg-198/GW_th · 14-yr cooldown discounted @3% (−34%)\n"
+        "Hg-198 enrichment-plant CAPEX excluded · gold sold at \\$100k/kg"),
+    2: (f"same P_fus as 1 GWe baseline (net {NET_REAL:.0f} MWe)\n"
+        f"200 MW_th heat @ \\$50/MWh_th · no TES / capacity revenue"),
+    3: ("≈1 GW_th firm heat @ \\$78/MWh_th (high-grade)\n"
+        "+ \\$139/kW-yr capacity · ~100 MWe byproduct → 1¢/kWh\n"
+        "(OPTIMISTIC)"),
+    4: ("200 MWe @ 100 MW baseload electrolyzer, throttling to full\n"
+        "during 5%-of-yr curtailment (1.2% recovered) · H2 sells @ \\$4/kg"),
+    5: ("900 MWe baseload electrolyzer → ~136 kt/yr H2. \\$4/kg H2 sell price\n"
+        "<< ~\\$7/kg delivered → electricity LCOE blows out"),
+}
+for _i, _t in _detail.items():
+    ax.text(-0.008, _i + 0.26, _t, transform=_tr, ha="right", va="top",
+            fontsize=6.3, color="dimgray", linespacing=1.15)
+
+ax.set_xlabel("effective LCOE [$/MWh]")
+ax.set_title("Effective LCOE of a 1 GWe D-T tokamak by revenue stream",
+             fontweight="bold")
+for i, v in enumerate(vals):
+    if v > CAP:
+        ax.text(CAP - 3, i, f"{v:.0f} ▶  off-scale", va="center", ha="right",
+                fontsize=9, color="white", fontweight="bold")
+    else:
+        ax.text(v + (3 if v >= 0 else -3), i, f"{v:.0f}",
+                va="center", ha="left" if v >= 0 else "right", fontsize=9)
+ax.set_xlim(0, CAP)
+ax.legend()
+fig.tight_layout()
+fig.subplots_adjust(left=0.35)  # keep the left margin wide enough for the sub-notes
+OUT = r"C:\Users\mallo\Deterministic_Concept_scoring\revenue_stream_comparison.png"
+fig.savefig(OUT, dpi=140)
+print("\nsaved:", OUT)
+
+# ---------------------------------------------- % cogen optimization figure
+fr = np.linspace(0.05, 0.85, 30)
+best = [apply_offsets(Rb, OffsetParams(heat_on=True, heat_mode="cogen",
+        heat_frac=f, heat_price_ratio=1.0), **GK).net_lcoe for f in fr]
+worst = [apply_offsets(Rb, OffsetParams(heat_on=True, heat_mode="cogen",
+        heat_frac=f, heat_price_ratio=0.35), **GK).net_lcoe for f in fr]
+fig2, ax2 = plt.subplots(figsize=(9, 5.2))
+ax2.plot(fr * 100, best, lw=2.6, color="#2f9e63",
+         label="BEST - high-grade cogen (Mh/Me=1.0)")
+ax2.plot(fr * 100, worst, lw=2.6, color="#c1440e",
+         label="WORST - low-grade cogen (Mh/Me=0.35)")
+ax2.axhline(BASE, ls="--", c="gray", lw=1, label=f"base electricity {BASE:.0f} $/MWh")
+ax2.axhline(0, ls=":", c="k", lw=0.8)
+ax2.set_xlabel("% of output diverted to heat  (cogen fraction)")
+ax2.set_ylabel("effective LCOE [$/MWh]")
+ax2.set_title("Re-optimizing % cogen - heat taken upstream of the turbine\n"
+              "(monotonic -> corner solutions, not an interior optimum)",
+              fontweight="bold", fontsize=11)
+ax2.legend(fontsize=8.5, loc="center left")
+ax2.grid(alpha=0.3)
+fig2.tight_layout()
+OUT2 = r"C:\Users\mallo\Deterministic_Concept_scoring\revenue_heat_cogen_optimization.png"
+fig2.savefig(OUT2, dpi=140)
+print("saved:", OUT2)
diff --git a/rigid_vs_flexible_v2.py b/rigid_vs_flexible_v2.py
new file mode 100644
index 0000000..a5fab02
--- /dev/null
+++ b/rigid_vs_flexible_v2.py
@@ -0,0 +1,62 @@
+"""Rigid 50/50 (A) vs flexible (B), but SIZE B's TES to the peak window.
+B keeps the 50/50 baseline, then shifts 500 MW_e out of the N cheapest hours
+into the N most expensive hours (heat->0 at peak, covered by TES; heat->max
+off-peak, recharging TES). TES = 1250 MW_th * N hours. Sweep N for max NPV.
+"""
+import numpy as np
+
+MULT = np.array([0.80,0.75,0.72,0.72,0.75,0.82,0.92,1.00,0.98,0.85,0.70,0.60,
+                 0.55,0.55,0.60,0.72,0.95,1.35,1.75,1.85,1.60,1.25,1.00,0.88])
+MULT = MULT / MULT.mean()
+ME = 60.0; PRICE = MULT * ME; MH = 30.0
+Q = 2500.0; ETA = 0.40; AVAIL = 0.85; CRF = 0.0806; ANN = 12.409
+BASE_CAP = 8614.0 - 258.0; OM = 127.0; FUEL = 0.8
+TURB = 258.0; TESK = 30.0; BOP = 200.0
+H = 0.5 * Q; HRS = 365.0 * AVAIL
+psort = np.sort(PRICE)                       # ascending
+heat_rev = H * MH * 8760.0 * AVAIL / 1e6
+
+def profit(elec_rev, tes_mwhth, turb_mwe):
+    cap = (BASE_CAP + TURB*turb_mwe*1e3/1e6 + TESK*tes_mwhth*1e3/1e6 + BOP*H*1e3/1e6)
+    return elec_rev + heat_rev - (CRF*cap + OM + FUEL), cap
+
+# A: rigid 500 MW_e flat, no TES
+elec_A = 500.0 * PRICE.sum() * HRS / 1e6
+pA, cA = profit(elec_A, 0.0, 500.0)
+
+# B(N): shift 500 MW_e from N cheapest to N priciest hours; TES = 1250*N MWh_th
+print("Sizing B's TES window (each shifted hour needs 1250 MWh_th of TES):")
+print(f"{'N (h)':>6}{'TES MWh_th':>12}{'peak used $/MWh':>17}{'B profit $M/yr':>16}{'B-A NPV $B':>12}")
+bestN, bestP = 0, -1e9
+for N in range(1, 13):
+    top = psort[-N:]; bot = psort[:N]
+    uplift = 500.0 * (top.sum() - bot.sum()) * HRS / 1e6   # revenue shifted
+    elec_B = elec_A + uplift
+    tes = H * N
+    pB, cB = profit(elec_B, tes, 1000.0)
+    dnpv = (pB - pA) * ANN / 1e3
+    mark = ""
+    if pB > bestP: bestP, bestN = pB, N;
+    print(f"{N:>6}{tes:>12,.0f}{top.mean():>17.0f}{pB:>16.0f}{dnpv:>12.2f}")
+
+# optimum
+top = psort[-bestN:]; bot = psort[:bestN]
+uplift = 500.0 * (top.sum() - bot.sum()) * HRS / 1e6
+pB, cB = profit(elec_A + uplift, H*bestN, 1000.0)
+print(f"\nA  rigid 50/50: NPV ${pA*ANN/1e3:.2f}B (turbine 500 MW_e, no TES, cap ${cA:,.0f}M)")
+print(f"B* optimal:     NPV ${pB*ANN/1e3:.2f}B at N={bestN} h TES ({H*bestN:,.0f} MWh_th), "
+      f"turbine 1000 MW_e, cap ${cB:,.0f}M")
+print(f"B* - A:         {(pB-pA):+.0f} $M/yr -> {(pB-pA)*ANN/1e3:+.2f} $B NPV")
+print(f"  (vs the naive 12 h-TES B which was only +0.17 $B)")
+
+print("\nB*-A NPV vs volatility (peak height), TES re-optimized each time:")
+for vol in [1.0, 1.5, 2.0, 3.0]:
+    pr = np.sort(ME + (PRICE - ME) * vol)
+    ea = 500.0 * pr.sum() * HRS / 1e6
+    best = -1e9; bn = 0
+    for N in range(1, 13):
+        up = 500.0 * (pr[-N:].sum() - pr[:N].sum()) * HRS / 1e6
+        pb, cb = profit(ea + up, H*N, 1000.0)
+        pa2, _ = profit(ea, 0.0, 500.0)
+        if pb-pa2 > best: best, bn = pb-pa2, N
+    print(f"   vol x{vol}: peak ${pr.max():.0f} -> best N={bn}h, B-A NPV {best*ANN/1e3:+.2f} $B")
diff --git a/src/costingfe/revenue_offsets.py b/src/costingfe/revenue_offsets.py
new file mode 100644
index 0000000..0326863
--- /dev/null
+++ b/src/costingfe/revenue_offsets.py
@@ -0,0 +1,472 @@
+"""Alternate-revenue overlay for D-T tokamak fusion power plants.
+
+Non-invasive TEA layer that consumes a `ForwardResult` from the core costing
+model and applies *toggleable* co-product revenue streams, returning a net LCOE.
+It never mutates the core model; it reads the cost breakdown + power table and
+computes an offset LCOE on top.
+
+Streams (each independently ON/OFF), grounded in:
+  - Gold  : Rutkowski, Harter & Parisi (2025), Scalable Chrysopoeia via (n,2n).
+            198Hg(n,2n)197Hg -> 197Au in the blanket multiplier layer. ADDITIVE:
+            the (n,2n) is required for TBR anyway, so gold does not divert output.
+  - Heat  : Ward, Majeed & Lopes Cardozo (2025), Fusion for high-value heat.
+            SUBSTITUTIVE: sells thermal output as heat instead of converting to
+            electricity; only wins when Mh/Me > eta_gen.
+  - H2    : Handley, Slesinski & Hsu (2021), Potential Early Markets for Fusion.
+            DERIVATIVE: converts electricity (or heat) to hydrogen; only wins
+            when the H2 value beats the displaced electricity.
+
+Accounting convention (Parisi & Schiller 2026, eq. 12 -- byproduct credit):
+
+    LCOE_net = [ (CAS90 + CAS70 + CAS80)               # base plant annual cost
+               + dCAPEX * CRF + dOM                     # incremental offset costs
+               - R_gold - R_heat - R_h2 ]               # co-product revenue
+               * 1e6 / (8760 * P_elec_sold * avail)
+
+Gold is a pure credit (P_elec_sold unchanged).  Heat and H2 divert output, so
+they reduce P_elec_sold; they only lower LCOE when the product revenue exceeds
+the electricity revenue they displaced (valued at the base breakeven LCOE).
+
+GATING: offsets apply ONLY to a D-T tokamak (concept == TOKAMAK, fuel == DT).
+For any other concept/fuel the overlay returns the base LCOE unchanged and flags
+`gated_off = True`.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field, replace
+
+from costingfe.layers.economics import compute_crf
+from costingfe.types import ConfinementConcept, Fuel
+
+# --- Physical constants -----------------------------------------------------
+HHV_H2_KWH_PER_KG = 39.4  # higher heating value of hydrogen [kWh/kg]
+
+
+@dataclass
+class OffsetParams:
+    """All alternate-revenue parameters and their ON/OFF toggles.
+
+    Defaults are the central estimates from the source papers; ranges for the
+    sensitivity study are documented inline.
+    """
+
+    # --- toggles ---
+    gold_on: bool = False
+    heat_on: bool = False
+    h2_on: bool = False
+
+    # --- shared economics (should mirror the forward() call) ---
+    interest_rate: float = 0.07
+    lifetime_yr: float = 30.0
+    neutron_multiplier: float = 1.1  # Mn: fusion power -> blanket thermal power
+
+    # --- GOLD (additive) ---
+    # Production: Marathon design point ~1 t/GW_th/yr (nameplate; scaled by
+    # availability below). Keyed to THERMAL power (GW_th), the basis Marathon
+    # quotes, not fusion power.
+    gold_kg_per_gwth_yr: float = 1000.0
+    gold_price_usd_per_kg: float = 100_000.0  # ~current LBMA; sensitivity to supply
+    # Radioactivity cooldown: transmuted gold needs ~10 yr to decay below sale
+    # limits. Radiation-placarded metal is non-fungible, so it cannot clear as
+    # loco-London / LBMA Good Delivery bullion until cooled. But it is a stable,
+    # physically-backed, near-certain future asset (price assumed hedged forward),
+    # so the delay is discounted at a low ~risk-free rate, NOT the plant equity
+    # WACC. 3% / 10 yr -> factor 1/1.03^10 = 0.744 (~26% haircut).
+    gold_cooldown_years: float = 14.0
+    gold_cooldown_rate: float = 0.03
+    # 198Hg inventory: Marathon design point ~100 t/GW_th.
+    hg_inventory_t_per_gwth: float = 100.0
+    hg_inventory_usd_per_kg: float = 30.0  # NATURAL mercury commodity price ($/kg)
+    hg_198_abundance: float = 0.0997  # natural fractional abundance of 198Hg
+    # -> raw Hg charged on ~1/0.0997 ~= 10x the enriched inventory (feedstock to
+    # enrich; depleted tails NOT credited back -- conservative per design intent)
+    # Photochemical enrichment OPERATING cost ~$2.4/kg-198Hg product (Rutkowski,
+    # Harter & Parisi 2025, single-step photo-enrichment to 99.2% @ $0.1/kWh).
+    # NOTE: this is the ENERGY/operating cost only. The enrichment-PLANT CAPITAL
+    # is NOT included here -- Marathon defers it as "preliminary... requiring
+    # further development", and it is the dominant unquantified swing in the gold
+    # economics (a centrifuge cascade for ~2800 t nat-Hg/yr could be ~$1-5B).
+    gold_sep_usd_per_kg_hg: float = 2.4
+    hg_burnup_frac_yr: float = 0.007  # 0.3-1.2%/yr consumed -> makeup enrichment
+    gold_extraction_capex_musd: float = 50.0  # Cu/Ta getter + processing loop
+    gold_extraction_om_frac: float = 0.05  # /yr of extraction capex
+    # Transmutation-blanket complexity markup, applied to the FW/blanket account
+    # (C220101). Central 10%: the mercury (n,2n) multiplier-breeder replaces a
+    # conventional Be/Pb multiplier (Hg is cheap as a material) but adds real
+    # premium for in-blanket liquid-mercury containment + circulation, Hg
+    # corrosion/amalgamation mitigation of structural steel, the online
+    # gold/Hg extraction interface, and activated-Hg (197/203) shielding &
+    # remote handling. Bounded below by "mercury material is cheap" and above by
+    # the ~1.5-2x FOAK premium seen for complex liquid-metal blankets. No costed
+    # mercury-blanket exists (2025 concept) -> engineering estimate; tune here.
+    # (This markup is a ~$1/MWh lever end-to-end; 30% -> 10% -> 0% spans only
+    # +1.6 -> +0.5 -> 0 $/MWh, so it is not a driver of the gold economics.)
+    blanket_complexity_frac: float = 0.10
+    gold_regulatory_om_musd: float = 3.0  # Minamata/handling compliance, M$/yr
+
+    # --- HEAT (substitutive) ---
+    # mode: "cogen"     = thermal bypass, sell own heat instead of electricity
+    #                     (low-grade; 1/eta_gen leverage; earns turbine credit)
+    #       "heat_pump" = divert electricity to a grid-scale heat pump, amplify
+    #                     by COP into HIGH-GRADE heat sold at a premium ratio
+    heat_mode: str = "cogen"
+    heat_frac: float = 1.0  # fraction of output (cogen) or electricity (HP) to heat [0-1]
+    heat_price_ratio: float = 1.0  # Mh/Me (heat price / base electricity price)
+    eta_gen: float = 0.40  # thermal->electric conversion efficiency
+    # grid-scale heat pump (heat_mode="heat_pump"):
+    hp_cop: float = 2.5  # coeff. of performance for the high-temp lift (2-4)
+    hp_capex_usd_per_kwth: float = 800.0  # $/kW_th of high-grade heat output (500-1500)
+    hp_om_frac: float = 0.04  # /yr of heat-pump capital
+    # capital effects of cogeneration:
+    # (+) cogen sizes the power block only for the electricity it still makes,
+    #     so it saves heat_frac of the turbine (CAS23) + heat-rejection (CAS26).
+    heat_avoided_turbine_frac: float = 1.0  # 0-1 of the pro-rata CAS23+CAS26 credit
+    # (-) high-temp heat export: HX + insulated HT piping + offtaker tie-in
+    heat_export_capex_usd_per_kwth: float = 200.0  # $/kW_th of diverted heat
+    heat_export_om_frac: float = 0.03  # /yr of heat-export+storage capital
+    # (-) integrated thermal storage (firm heat / buffer; Handley 2021).
+    # ON by default: firm high-temp heat delivery essentially requires it.
+    heat_storage_hours: float = 4.0  # hours of thermal storage (0 = none)
+    heat_storage_capex_usd_per_kwhth: float = 30.0  # $/kWh_th (molten-salt class)
+
+    # --- H2 / synfuels (derivative) ---
+    # Two H2 energy sources: (1) baseload diversion of SALEABLE electricity
+    # (h2_frac; opportunity cost = grid price) and (2) recovered curtailment
+    # (h2_cf_recovery_frac; ~free feedstock -- energy a grid-only plant wastes).
+    # CAPEX/OPEX/efficiency/logistics aligned to the interactive H2-led tool.
+    h2_frac: float = 1.0  # baseload diversion of saleable electricity [0-1]
+    h2_cf_recovery_frac: float = 0.0  # curtailment recovered -> H2 (free feedstock)
+    h2_price_usd_per_kg: float = 4.0  # $1-2 green target, up to $6 high-value
+    h2_conv_eff: float = 0.758  # HHV basis -> 52 kWh/kg (tool's alkaline electrolyzer)
+    h2_electrolyzer_capex_usd_per_kw: float = 700.0  # tool-aligned ($300-1000/kW range)
+    h2_om_frac: float = 0.03  # /yr of electrolyzer capex (tool-aligned)
+    h2_logistics_usd_per_kg: float = 0.80  # compression + buffer + local pipeline
+    h2_electrolyzer_mw: "float | None" = None  # explicit nameplate; else auto-size
+
+    # --- CAPACITY MARKET (firm dispatchable capacity; optional) ---
+    capacity_price_usd_per_kw_yr: float = 0.0  # 0 = no capacity market
+    upsized_turbine: bool = False  # keep the full turbine so a TES-firmed plant can
+    # throttle to full net electric at peak (no cogen downsizing) -> qualifies the
+    # full net capacity for the capacity market (mirrors the interactive tool)
+    # --- explicit prices (optional; override the ratio-based defaults) ---
+    heat_price_usd_per_mwhth: "float | None" = None  # explicit Mh; overrides ratio
+    elec_price_usd_per_mwh: "float | None" = None  # explicit Me (display/memo; LCOE unaffected)
+
+
+@dataclass
+class OffsetResult:
+    base_lcoe: float
+    net_lcoe: float
+    gated_off: bool
+    p_elec_sold_mw: float
+    # annual figures, M$/yr
+    base_annual_cost: float
+    energy_sold_mwh: float = 0.0
+    gold_revenue: float = 0.0
+    gold_cost: float = 0.0
+    heat_revenue: float = 0.0
+    heat_elec_displaced_value: float = 0.0
+    capacity_revenue: float = 0.0
+    h2_revenue: float = 0.0
+    h2_cost: float = 0.0
+    notes: list[str] = field(default_factory=list)
+    # granular line items: dicts {stream, label, kind, musd_yr}
+    # kind in {"revenue", "cost"}; capital already annualized (x CRF)
+    items: list = field(default_factory=list)
+
+
+def _fw_blanket_share(cas22_detail) -> float:
+    """First-wall + breeding-blanket account (C220101), the base for the gold
+    transmutation-blanket complexity markup.
+
+    The mercury/(n,2n) multiplier-breeder layer (Rutkowski, Harter & Parisi
+    2025, arXiv:2507.13461: an enriched-198Hg inner layer alloyed with Li-6)
+    is a modification of THIS account -- the FW/blanket -- NOT of the whole
+    reactor plant equipment (magnets, current drive, etc.).  Exposed as a
+    sensitivity via blanket_complexity_frac.
+    """
+    return float(cas22_detail.get("C220101", 0.0))
+
+
+def apply_offsets(
+    result,
+    offset: OffsetParams,
+    *,
+    concept: ConfinementConcept,
+    fuel: Fuel,
+    availability: float,
+    n_mod: float = 1.0,
+) -> OffsetResult:
+    """Layer toggleable co-product revenue offsets onto a ForwardResult.
+
+    Returns an OffsetResult with the net LCOE and a full revenue/cost breakdown.
+    Offsets are forced off (gated_off=True) unless concept==TOKAMAK & fuel==DT.
+    """
+    costs = result.costs
+    pt = result.power_table
+    base_lcoe = float(costs.lcoe)  # $/MWh, also serves as reference Me
+    p_net = float(pt.p_net) * n_mod  # MWe
+    p_fus = float(pt.p_fus) * n_mod  # MW fusion
+    base_annual_cost = float(costs.cas90 + costs.cas70 + costs.cas80)  # M$/yr
+
+    gated = not (concept == ConfinementConcept.TOKAMAK and fuel == Fuel.DT)
+    if gated:
+        return OffsetResult(
+            base_lcoe=base_lcoe,
+            net_lcoe=base_lcoe,
+            gated_off=True,
+            p_elec_sold_mw=p_net,
+            base_annual_cost=base_annual_cost,
+            notes=["Offsets apply only to D-T tokamak; returned base LCOE."],
+        )
+
+    crf = compute_crf(offset.interest_rate, offset.lifetime_yr)
+    p_gwfus = p_fus / 1000.0  # GW fusion
+    p_gwth = float(pt.p_th) * n_mod / 1000.0  # GW thermal (gold/Hg basis)
+    # Anchor to the model's OWN energy denominator (captures its effective
+    # availability), so base-all-off reproduces costs.lcoe exactly and every
+    # diverted-output slice stays consistent with the core model.
+    annual_energy_base_mwh = base_annual_cost * 1e6 / base_lcoe
+
+    d_capex = 0.0  # M$ incremental capital
+    d_om = 0.0  # M$/yr incremental O&M
+    revenue = 0.0  # M$/yr co-product credit
+    p_elec_sold = p_net  # MWe actually sold as electricity
+    frac_sold = 1.0  # fraction of base electric energy still sold as electricity
+    notes: list[str] = []
+    items: list = []  # granular line items (annualized M$/yr)
+
+    def add(stream, label, kind, musd_yr):
+        items.append(
+            {"stream": stream, "label": label, "kind": kind, "musd_yr": musd_yr}
+        )
+
+    out = OffsetResult(
+        base_lcoe=base_lcoe,
+        net_lcoe=base_lcoe,
+        gated_off=False,
+        p_elec_sold_mw=p_net,
+        base_annual_cost=base_annual_cost,
+    )
+
+    # --- GOLD: additive credit, no output diversion --------------------------
+    if offset.gold_on:
+        au_kg_yr = (
+            offset.gold_kg_per_gwth_yr * p_gwth * availability
+        )
+        cooldown_factor = 1.0 / (
+            1.0 + offset.gold_cooldown_rate
+        ) ** offset.gold_cooldown_years
+        r_gold = (
+            au_kg_yr
+            * offset.gold_price_usd_per_kg
+            * cooldown_factor
+            / 1e6
+        )  # M$/yr, sale delayed by the activation cooldown
+        # costs
+        hg_inv_t = offset.hg_inventory_t_per_gwth * p_gwth  # enriched 198Hg
+        # Raw mercury feedstock: to hold `hg_inv_t` of enriched 198Hg you must
+        # buy ~10x that mass of natural Hg (198Hg is only ~10% of natural Hg).
+        hg_feed_t = hg_inv_t / offset.hg_198_abundance
+        hg_feed_musd = hg_feed_t * 1e3 * offset.hg_inventory_usd_per_kg / 1e6
+        hg_makeup_kg_yr = hg_inv_t * 1e3 * offset.hg_burnup_frac_yr
+        sep_om = hg_makeup_kg_yr * offset.gold_sep_usd_per_kg_hg / 1e6  # M$/yr
+        # NOTE: enrichment-PLANT CAPITAL is intentionally EXCLUDED (unquantified;
+        # see gold_sep_usd_per_kg_hg comment). Only the photochemical OPEX enters.
+        blanket_bump = (
+            _fw_blanket_share(result.cas22_detail) * offset.blanket_complexity_frac
+        )
+        gold_capex = (
+            offset.gold_extraction_capex_musd + hg_feed_musd + blanket_bump
+        )
+        gold_om = (
+            offset.gold_extraction_capex_musd * offset.gold_extraction_om_frac
+            + sep_om
+            + offset.gold_regulatory_om_musd
+        )
+        c_gold = gold_capex * crf + gold_om  # annualized M$/yr
+        d_capex += gold_capex
+        d_om += gold_om
+        revenue += r_gold
+        out.gold_revenue = r_gold
+        out.gold_cost = c_gold
+        notes.append(f"Gold: {au_kg_yr:,.0f} kg/yr")
+        notes.append("Enrichment-PLANT CAPEX excluded (unquantified; photo-OPEX only)")
+        add("gold", "Gold sales (197Au)", "revenue", r_gold)
+        add("gold", "198Hg enrichment (photochemical OPEX)", "cost", sep_om)
+        add("gold", "Mercury feedstock (natural, ~10x enriched)", "cost",
+            hg_feed_musd * crf)
+        add("gold",
+            f"Transmutation-blanket complexity ({offset.blanket_complexity_frac:.0%} of FW/blanket)",
+            "cost", blanket_bump * crf)
+        add("gold", "Au extraction loop (capital)", "cost",
+            offset.gold_extraction_capex_musd * crf)
+        add("gold", "Au extraction O&M", "cost",
+            offset.gold_extraction_capex_musd * offset.gold_extraction_om_frac)
+        add("gold", "Regulatory/Minamata O&M", "cost", offset.gold_regulatory_om_musd)
+
+    # --- HEAT: substitution, diverts output ---------------------------------
+    if offset.heat_on:
+        me = (offset.elec_price_usd_per_mwh
+              if offset.elec_price_usd_per_mwh is not None else base_lcoe)  # $/MWh
+        mh = (offset.heat_price_usd_per_mwhth
+              if offset.heat_price_usd_per_mwhth is not None
+              else offset.heat_price_ratio * me)  # $/MWh_th heat price
+        # electric energy foregone: cogen bypasses thermal; HP consumes electricity.
+        # Both reduce electricity sold by heat_frac of base output.
+        elec_displaced_mwh = annual_energy_base_mwh * offset.heat_frac
+        frac_sold -= offset.heat_frac
+        p_elec_sold -= offset.heat_frac * p_net
+        displaced_value = elec_displaced_mwh * me / 1e6  # M$/yr electricity foregone
+
+        hp_capex = 0.0
+        if offset.heat_mode == "heat_pump":
+            # divert electricity to a heat pump -> COP x high-grade heat, sold at a
+            # premium ratio. Full turbine still runs (electricity feeds the HP), so
+            # NO turbine credit. Heat pump capital sized to its heat output.
+            heat_mwh_yr = offset.hp_cop * elec_displaced_mwh
+            heat_thermal_mw = offset.hp_cop * offset.heat_frac * p_net
+            avoided_pc = 0.0
+            hp_capex = heat_thermal_mw * 1e3 * offset.hp_capex_usd_per_kwth / 1e6
+        else:  # cogen thermal bypass: keep full thermal (no eta_gen loss)
+            heat_mwh_yr = elec_displaced_mwh / offset.eta_gen
+            heat_thermal_mw = offset.heat_frac * p_net / offset.eta_gen
+            # cogen turbine sized only for retained electricity -> save heat_frac
+            # of CAS23 (turbine) + CAS26 (heat reject). But an UPSIZED turbine is
+            # kept full-size (no credit) so a TES-firmed plant can throttle to full
+            # net electric at peak and qualify the full capacity.
+            avoided_pc = (
+                0.0 if offset.upsized_turbine else
+                offset.heat_avoided_turbine_frac
+                * offset.heat_frac
+                * (float(costs.cas23) + float(costs.cas26))
+            )
+        r_heat = heat_mwh_yr * mh / 1e6  # M$/yr
+
+        # (-) high-temp heat-export BoP (HX + insulated HT piping + tie-in)
+        export_capex = (
+            heat_thermal_mw * 1e3 * offset.heat_export_capex_usd_per_kwth / 1e6
+        )
+        # (-) integrated thermal storage
+        storage_capex = (
+            offset.heat_storage_hours
+            * heat_thermal_mw
+            * 1e3
+            * offset.heat_storage_capex_usd_per_kwhth
+            / 1e6
+        )
+        heat_capex = export_capex + storage_capex + hp_capex - avoided_pc  # net M$
+        heat_om = (
+            (export_capex + storage_capex) * offset.heat_export_om_frac
+            + hp_capex * offset.hp_om_frac
+        )
+        d_capex += heat_capex
+        d_om += heat_om
+        revenue += r_heat
+        out.heat_revenue = r_heat
+        out.heat_elec_displaced_value = displaced_value
+        notes.append(
+            f"Heat[{offset.heat_mode}]: {heat_mwh_yr/1e6:,.2f} TWh_th/yr "
+            f"@ Mh/Me={offset.heat_price_ratio}"
+            + (" (beats elec)" if r_heat > displaced_value else " (LOSES vs elec)")
+        )
+        add("heat", "Heat sales", "revenue", r_heat)
+        if avoided_pc:
+            add("heat", "Avoided turbine+heat-reject (CAS23+26)", "revenue", avoided_pc * crf)
+        if hp_capex:
+            add("heat", "Grid-scale heat pump (capital)", "cost", hp_capex * crf)
+        add("heat", "HT heat-export BoP (HX+piping)", "cost", export_capex * crf)
+        if storage_capex:
+            add("heat", "Thermal storage (capital)", "cost", storage_capex * crf)
+        add("heat", "Heat/HP/storage O&M", "cost", heat_om)
+        # foregone electricity is captured by the reduced denominator, NOT summed
+        add("heat", "(electricity foregone, in denominator)", "memo", displaced_value)
+
+    # --- CAPACITY MARKET: firm dispatchable-capacity revenue ----------------
+    if offset.capacity_price_usd_per_kw_yr > 0:
+        # upsized turbine + TES lets the plant throttle to full net electric at
+        # peak (the store covers the heat); otherwise only the cogen electric
+        # output qualifies as firm capacity.
+        cap_mw = p_net if offset.upsized_turbine else p_elec_sold
+        r_cap = cap_mw * 1e3 * offset.capacity_price_usd_per_kw_yr / 1e6  # M$/yr
+        revenue += r_cap
+        out.capacity_revenue = r_cap
+        notes.append(
+            f"Capacity: {cap_mw:,.0f} MW @ "
+            f"${offset.capacity_price_usd_per_kw_yr:.0f}/kW-yr"
+        )
+        add("capacity", "Capacity market", "revenue", r_cap)
+
+    # --- H2: derivative -----------------------------------------------------
+    if offset.h2_on:
+        # (1) baseload diversion of saleable electricity (reduces grid sales)
+        elec_to_h2_mwh = annual_energy_base_mwh * frac_sold * offset.h2_frac
+        frac_sold -= frac_sold * offset.h2_frac
+        p_elec_sold -= offset.h2_frac * p_elec_sold
+        # (2) recovered curtailment: free feedstock, ADDS H2 without touching
+        #     grid sales (energy a grid-only plant would have wasted)
+        recovered_mwh = annual_energy_base_mwh * offset.h2_cf_recovery_frac
+        total_h2_mwh = elec_to_h2_mwh + recovered_mwh
+        h2_kg_yr = (
+            total_h2_mwh * 1e3 * offset.h2_conv_eff
+        ) / HHV_H2_KWH_PER_KG
+        r_h2 = h2_kg_yr * offset.h2_price_usd_per_kg / 1e6  # M$/yr
+        # electrolyzer: explicit nameplate if given, else sized to avg diverted power
+        if offset.h2_electrolyzer_mw is not None:
+            elec_capacity_kw = offset.h2_electrolyzer_mw * 1e3
+        else:
+            elec_capacity_kw = total_h2_mwh / (8760 * 0.85) * 1e3
+        h2_capex = (
+            elec_capacity_kw * offset.h2_electrolyzer_capex_usd_per_kw / 1e6
+        )  # M$
+        h2_om = h2_capex * offset.h2_om_frac
+        h2_logistics = h2_kg_yr * offset.h2_logistics_usd_per_kg / 1e6  # M$/yr
+        c_h2 = h2_capex * crf + h2_om + h2_logistics
+        d_capex += h2_capex
+        d_om += h2_om + h2_logistics
+        revenue += r_h2
+        out.h2_revenue = r_h2
+        out.h2_cost = c_h2
+        notes.append(f"H2: {h2_kg_yr/1e6:,.1f} kt/yr @ ${offset.h2_price_usd_per_kg}/kg")
+        add("h2", "Hydrogen sales", "revenue", r_h2)
+        add("h2", "Electrolyzer (capital)", "cost", h2_capex * crf)
+        add("h2", "Electrolyzer O&M", "cost", h2_om)
+        add("h2", "H2 logistics", "cost", h2_logistics)
+        if elec_to_h2_mwh > 0:
+            add("h2", "(saleable electricity foregone, in denominator)", "memo",
+                elec_to_h2_mwh * base_lcoe / 1e6)
+
+    # --- net LCOE ------------------------------------------------------------
+    net_annual_cost = base_annual_cost + d_capex * crf + d_om - revenue  # M$/yr
+    energy_sold_mwh = annual_energy_base_mwh * frac_sold
+    if energy_sold_mwh <= 1e-6:
+        notes.append(
+            "All electricity diverted; net LCOE undefined -- report product LCOX instead."
+        )
+        net_lcoe = float("nan")
+    else:
+        net_lcoe = net_annual_cost * 1e6 / energy_sold_mwh
+
+    out.p_elec_sold_mw = p_elec_sold
+    out.net_lcoe = net_lcoe
+    out.notes = notes
+    out.items = items
+    out.energy_sold_mwh = energy_sold_mwh
+    return out
+
+
+def sweep(
+    result,
+    base_offset: OffsetParams,
+    param_name: str,
+    values,
+    **gate_kwargs,
+) -> list[tuple[float, float]]:
+    """One-parameter sensitivity sweep. Returns [(value, net_lcoe), ...]."""
+    out = []
+    for v in values:
+        p = replace(base_offset, **{param_name: v})
+        r = apply_offsets(result, p, **gate_kwargs)
+        out.append((v, r.net_lcoe))
+    return out
